 " Auteur : RIOCHE.P           a Champs/Marne      le 09/11/92          V1.1
"FILSYS - Genere un Jcl Filsys de List, Save, ou Restore.
"
" FRED FILSYS permet de creer des Jcl de List, Save, Restore
" d'umc, de Pack, ou des permanents.
" Mode d'emploi :
"             { List }  { PErm                                  }
" FRED FILSYS { Save }  { PAck=nom_de_pack [Type_de_pack=xxxPK] } [{+|-}TMs] (-)
"             { Rest }  { Umc=nom_d'umc                         }
"      et on vous genere dans le fichier courant un petit JCL
"      (par defaut type_de_pack = k2cpk)
"

 " =====================================================================
 " Stockage et initialisation pour FRED
 " Positionnement des options par defaut de FRED
 " =====================================================================
o+q o-p o+i o-ia o-i( o+s(){[|$^& o-s+@#<>

 " =====================================================================
 " Definition de quelques modeles generaux
 " =====================================================================
e(nl)/
/                                                  " Retour Chariot
ea/[abcdefghijlkmopqrstuvwxyz]/                    " Alphabetique
eb/[	 ]/                                          " Blanc espace et tabulateur
ed/[0123456789]/                                   " Numerique

 " =====================================================================
 " Constitution des buffers avec execution du programme principal
 " =====================================================================
b.
g/^>./ .s/^.//m(name) t/^>/ jt .,/^>/-1m((name))
       d                       " supprime la ligne de terminaison ">"
b(strings) g/^{[^ 	]*}q[ 	]*=/ s//q
/^,.s/
// ^m(name) .m((name))
zd(strings) zd(name) b0
(main) q

 " =====================================================================
 " Analyse des parametres selon la norme du B package :
 " =Valeur   : option par valeur  => saisie utilisateur : v=20 ou V=20 ou va=20
 " +Flag     : option par drapeau => saisie utilisateur : +f ou -F ou +flag
 " _Lettre   : option par lettres => saisie utilisateur : L ou let ou lettre
 "
 " Pour les options par valeur : le resultat est place dans un buffer ayant
 " le nom de l'option. Il y a en plus un registre de meme nom egal a 1.
 "
 " Pour les options par drapeau : un registre est assigne a +1 ou -1
 " en fonction du + ou -. Si l'option n'est pas specifiee le registre sera a 0.
 "
 " Pour les options par lettres : un registre est assigne a +1 si l'option
 " est specifiee. Si l'option n'est pas specifiee le registre sera a 0.
 "
 " NB : Pour l'option par valeur, si vous voulez utiliser des valeurs par
 "      defaut dans la section string, il suffit de remplacer dans
 "      le buffer getopt le ".zm" par ".m".
 " =====================================================================
>getopt
b(opts)
g/^=.*$/ s/^=// k(pat) k(name) b(name) .zl 
    b(pat) o-sd s/[abcdefghijklmnopqrstuvwxyz]/(&|)/ s/(nl)//
    b(0) o+sd g/^(pat)=/ s/// s/(nl)// .zm((name)) n((name))+1
    b((name)) $nxa nx<2 jt je parametre (name)= specifie 2 fois!
g/^+.*$/ s/^+// k(pat) k(name) b(name) .zl 
    b(pat) o-sd s/[abcdefghijklmnopqrstuvwxyz]/(&|)/ s/(nl)//
    b(0) o+sd nx:0 g/^+(pat)$/ n((name))+1 d nx+1
                   g/^-(pat)$/ n((name))-1 d nx+1
    b((name)) nx<2 jt je parametre +-(name) specifie 2 fois!
g/^_.*$/ s/^_// k(pat) k(name) b(name) .zl 
    b(pat) o-sd s/[abcdefghijklmnopqrstuvwxyz]/(&|)/ s/(nl)//
    b(0) o+sd nx:0 g/^(pat)$/ n((name))+1 d nx+1
    b((name)) nx<2 jt je parametre (name) specifie 2 fois!
b0
>

 " =====================================================================
 " Procedure de redirection de l'affichage. Ce buffer regarde si">file" ou
 " ">>file" est present sur la ligne de commande dans b(0) et prepare un
 " buffer b(write) qui peut etre utilise pour afficher le buffer 'courant'.
 " Le buffer sera imprime sur le terminal, ecrit dans "file"
 " ou ajoute a la suite du fichier redirige specifie.
 " =====================================================================
>redirect
b(0) nx:0 g/^>/ nx+1
nx>1 jf je redirection specifie plus d'une fois
nx=0 jf b(write) a *t/^/ jf *p zc  b(0) jo " imprime sur le terminal
.m(write) b(write) s/^>/*w / s/w >/zw / b(0)
>

>strings
ident   =exps......tss
poub    =bs
>

>opts
+TMs
_List
_Save
_Rest
_PErm
=PAck
=Type
=Umc
>

>main
o-i

(redirect)
(getopt)

b(action)
n(list)=1 jf a list
n(save)=1 jf a save
n(rest)=1 jf a rest

b(surqui)
n(umc)=1  jf a umc
n(pack)=1 jf a pack
n(perm)=1 jf a perm

       " Options par defaut
n(type)=0 jf b(type) a k2c
n(tms)=0  jf n(tms):-1

b((action)(surqui))
n(bufvide):$=0 jf q!fred expl filsys

n(tms)=1 jf *s!tape9!tapec!

b(stdout)
((action)(surqui))
(write)
>

>saveumc
a
$ **   save        de l'Umc (umc)
$      ident   (ident),sav.(umc)
$      filsys
$      privity
$      tape9   ps,x1d,,99999,,sav.(umc),,den62
$      tape9   xs,x2d,,99999,,cop.(umc),,den62
save   (umc),reset/rfiles/
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>savepack
a
$ **           Save Pack (pack)
$      ident   (ident),sav.(pack)
$      filsys
$      privity
savemast device/(type)pk,(pack)/,inclsys_,
reset/rfiles/
$      tape9   ps,p1d,,99999,,sav.(pack),,den62
$      tape9   xs,p2d,,99999,,cop.(pack),,den62
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>saveperm
a
$ **           Save des Permanents
$      ident   (ident),sav.permaments
$      filsys
$      privity
$      tape9   ps,p1d,,99999,,sav.perm,,den62
$      tape9   xs,p2d,,99999,,cop.perm,,den62
savemast listopt/no/,inclsys_,reset/rfiles/
$      sysout  j*,(poub)
$      sysout  p*,(poub)
$      endjob

>

>restumc
a
$ **   Restore     de l'Umc (umc)
$      ident   (ident),res.(umc)
$      filsys
$      privity
$      tape9   pr,x1d,,99999,,res.(umc),,den62
restore (umc),reset/rfiles/,reset/denied/,reset/device/
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>restpack
a
$ **   Restore      Pack (pack)
$      ident   (ident),res.(pack)
$      filsys
$      privity
restoremast device/(type)pk,(pack)/,inclsys_/all/,
reset/rfiles/
$      tape9   pr,p1d,,99999,,res.(pack),,den62
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>restperm
a
$ **   Restore des Permanents  ****
$      ident   (ident),res.permaments
$      filsys
$      privity
$      tape9   pr,p1d,,99999,,res.perm,,den62
restoremast listopt/no/,reset/rfiles/,inclsys_/all/
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>listumc
a
$ **   List        de l'Umc (umc)
$      ident   (ident),lis.(umc)
$      filsys
$      privity
maslst (umc)
$      sysout  j*,(poub)
$      sysout  p*,(poub)

>

>listpack
a
$ **           List  Pack (pack)
$      ident   (ident),lis.(pack)
$      filsys
$      privity
maslst device/(type)pk,(pack)/
